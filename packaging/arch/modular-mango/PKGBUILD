# Maintainer: Denys Madureira <denys@margarida-os.dev>
#
# VCS-style package built from git. It ships the Margarida-OS patches on top
# of upstream mangowm and replaces the official "mangowm" package because both
# install the same files (/usr/bin/mango, /etc/mango/config.*, session entry).
#
# _tag pins the release the package is built from. Releases are cut with
# v<upstream>-margarida.<n> tags, so pkgver keeps the upstream part first
# (v0.18.3-margarida.1 => 0.18.3.r0.g<hash>).

pkgname=modular-mango
_pkgname=mango
pkgver=0.18.2.r2.gcc950d2
pkgrel=1
pkgdesc='mangowm with Margarida-OS patches (Wayland compositor)'
arch=('x86_64')
url='https://github.com/Margarida-OS/mango'
license=('GPL-3.0-or-later')
depends=(
  'cairo'
  'glib2'
  'glibc'
  'libdisplay-info'
  'libdrm'
  'libinput'
  'libliftoff'
  'libxcb'
  'libxkbcommon'
  'pango'
  'pcre2'
  'pixman'
  'seatd'
  'wayland'
  'wayland-protocols'
  'wlroots0.20'
  'scenefx'
  'xcb-util-wm'
  'xorg-xwayland'
)
makedepends=(
  'cjson'
  'git'
  'libxcb'
  'meson'
  'ninja'
  'scenefx'
  'wlroots0.20'
  'xcb-util-wm'
)
provides=('mangowm')
conflicts=('mangowm' 'mango-git' 'modular-mango-git')
replaces=('mangowm')
backup=('etc/mango/config.conf' 'etc/mango/config.toml')
options=('!debug')
_tag='v0.18.3-margarida.1'
_pkgsrc="$_pkgname"
source=("$_pkgname"::"git+${url}.git#tag=${_tag}")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgsrc"
  # pkgver forbids hyphens, so v0.18.3-margarida.1 becomes
  # 0.18.3.margarida.1.r<n>.g<hash>: the upstream version still sorts first.
  local tag count hash
  tag=$(git describe --tags --abbrev=0 | sed 's/^v//;s/-/./g')
  count=$(git describe --long --tags | sed 's/^.*-\([0-9]*\)-g[0-9a-f]*$/\1/')
  hash=$(git rev-parse --short HEAD)

  printf '%s.r%s.g%s\n' "$tag" "$count" "$hash"
}

build() {
  cd "$_pkgsrc"
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    --wrap-mode=nodownload \
    -Dxwayland=enabled \
    -Dasan=false
  meson compile -C build
}

package() {
  cd "$_pkgsrc"
  meson install -C build --destdir "$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}